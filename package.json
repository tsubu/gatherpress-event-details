{
	"name": "gatherpress-event-details",
	"version": "0.1.0",
	"description": "Labeled details for GatherPress events, such as food, parking, or childcare.",
	"author": "tsubu",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gatherpress"
	],
	"homepage": "https://github.com/tsubu/gatherpress-event-details#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsubu/gatherpress-event-details.git"
	},
	"files": [
		"build",
		"includes",
		"languages",
		"gatherpress-event-details.php",
		"uninstall.php",
		"readme.txt"
	],
	"dependencies": {
		"@wordpress/block-editor": "^15.14.0",
		"@wordpress/blocks": "^15.14.0",
		"@wordpress/components": "^32.3.0",
		"@wordpress/compose": "^7.41.0",
		"@wordpress/core-data": "^7.41.0",
		"@wordpress/data": "^10.41.0",
		"@wordpress/editor": "^14.41.0",
		"@wordpress/element": "^6.41.0",
		"@wordpress/i18n": "^6.14.0",
		"@wordpress/plugins": "^7.41.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "vendor/bin/phpcs",
		"lint:phpstan": "vendor/bin/phpstan analyze --memory-limit=1G",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:unit:js": "wp-scripts test-unit-js",
		"test:unit:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/gatherpress-event-details vendor/bin/phpunit",
		"wp-env": "wp-env"
	}
}

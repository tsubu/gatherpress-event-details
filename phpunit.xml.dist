<?xml version="1.0"?>
<phpunit
	bootstrap="test/unit/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
>
	<testsuites>
		<testsuite name="gatherpress-event-details">
			<directory prefix="class-test-" suffix=".php">./test/unit/php/</directory>
		</testsuite>
	</testsuites>
	<coverage includeUncoveredFiles="true">
		<include>
			<directory suffix=".php">./includes</directory>
		</include>
	</coverage>
</phpunit>
